{
  "name": "@bro-know-my/spark-analyzer",
  "version": "0.1.2",
  "description": "Pure Vue UI for the bkmsa Rust analyzer.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bro-know-my-org/BroKnowMySparkAnalyzer",
    "directory": "packages/spark-analyzer"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/style.css"
  ],
  "keywords": [
    "spark",
    "analyzer",
    "vue",
    "tauri"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tauri": {
      "types": "./dist/tauri.d.ts",
      "import": "./dist/tauri.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "test": "vitest run",
    "build": "vite build && vue-tsc -p tsconfig.json --declaration --emitDeclarationOnly",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@vicons/fa": "^0.13.0",
    "@vicons/fluent": "^0.13.0",
    "naive-ui": "^2.43.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    },
    "@tauri-apps/plugin-dialog": {
      "optional": true
    },
    "@tauri-apps/plugin-opener": {
      "optional": true
    }
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "html-to-image": "^1.11.13",
    "marked": "^16.4.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  }
}
