{
  "name": "bro-know-my-spark-analyzer",
  "private": true,
  "version": "0.1.2",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "build:web": "vue-tsc --noEmit && vite build",
    "build:wasm": "wasm-pack build crates/bkmsa-wasm --mode no-install --target web --release --out-dir ../../public/bkmsa-wasm --out-name bkmsa_wasm",
    "build:site": "pnpm run build:wasm && pnpm run test:wasm && pnpm run build:web",
    "test:wasm": "node scripts/wasm-smoke.mjs",
    "check:rust": "cargo check --workspace --all-targets && cargo check --manifest-path src-tauri/Cargo.toml --all-targets",
    "test:rust": "cargo test --workspace --all-targets && cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "bkmsa": "cargo run -p bkmsa-cli --",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@vicons/fa": "^0.13.0",
    "@vicons/fluent": "^0.13.0",
    "html-to-image": "^1.11.13",
    "marked": "^16.4.1",
    "naive-ui": "^2.43.2",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.2.12"
  }
}
